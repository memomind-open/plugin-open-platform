{
  "name": "gm-phone-plugin-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:permissions": "node tools/run-browser-studio.mjs --plugin examples/permission-debug",
    "dev": "node tools/run-browser-studio.mjs --plugin examples/app-counter",
    "build:devkit": "node tools/build-devkit.mjs",
    "sync:example-sdk": "node tools/sync-example-sdk.mjs",
    "pack:plugin": "node tools/build-mmpkg.mjs",
    "test": "node --test packages/*/test/*.test.mjs tools/test/*.test.mjs",
    "check": "node tools/check-workspace.mjs",
    "verify": "npm test && npm run check"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
