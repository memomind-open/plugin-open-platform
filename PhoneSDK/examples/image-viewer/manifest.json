{
  "id": "com.memomind.example.image-viewer",
  "name": "Pixel Image Viewer",
  "version": "0.1.15",
  "entry": "index.html",
  "bridgeVersion": "2.0",
  "schemaVersion": 2,
  "permissionPolicyVersion": 1,
  "permissions": [
    { "name": "files.user-selected", "required": true },
    { "name": "storage", "required": true },
    { "name": "device.info", "required": true },
