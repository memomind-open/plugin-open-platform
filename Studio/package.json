{
  "name": "gm-plugin-studio-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cargo run --release --manifest-path desktop/src-tauri/Cargo.toml",
    "dev:debug": "cargo run --manifest-path desktop/src-tauri/Cargo.toml",
    "check": "cargo check --manifest-path desktop/src-tauri/Cargo.toml",
    "build": "cd desktop/src-tauri && cargo tauri build",
    "build:windows:x64": "node scripts/export-studio.mjs --platform windows-x64 --build --build-only --no-bundle --target x86_64-pc-windows-msvc --runner cargo-xwin",
    "export": "node scripts/export-studio.mjs --build --single-file",
    "export:collect": "node scripts/export-studio.mjs",
    "export:linux:x64": "bash scripts/export-linux-x64.sh",
    "export:windows:x64": "node scripts/export-studio.mjs --platform windows-x64 --build --target x86_64-pc-windows-msvc --runner cargo-xwin --bundles nsis --single-file",
    "test:ui": "node --test desktop/ui/tests/*.test.mjs",
    "test:tools": "node --test scripts/*.test.mjs",
    "test:native": "cargo test --manifest-path desktop/src-tauri/Cargo.toml",
    "test": "npm run test:ui && npm run test:tools"
  }
}
