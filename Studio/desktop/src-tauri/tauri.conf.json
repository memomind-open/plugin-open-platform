{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GM Plugin Studio",
  "version": "0.1.0",
  "identifier": "com.memomind.gm-plugin-studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GM Plugin Studio",
        "width": 1500,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
