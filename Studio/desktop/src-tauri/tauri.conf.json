{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MemoMind Plugin Studio",
  "version": "0.1.0",
  "identifier": "com.memomind.gm-plugin-studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html?v=20260828-toolbar-compact",
        "title": "MemoMind Plugin Studio",
        "width": 1800,
        "height": 920,
        "minWidth": 1500,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
